# --- Google Sheets connection (primary PO data source) ---
# Paste the full URL of the Google Sheet here, OR just the Sheet ID
# (the long string in the sheet URL between /d/ and /edit).
GOOGLE_SHEET_URL=
GOOGLE_SHEET_ID=

# Tab/range to read per marketplace. If every marketplace lives in one tab
# with a "Marketplace" column, set one range and leave the rest blank.
GOOGLE_SHEET_RANGE_ALL=
GOOGLE_SHEET_RANGE_ZEPTO=
GOOGLE_SHEET_RANGE_BLINKIT=
GOOGLE_SHEET_RANGE_INSTAMART=
GOOGLE_SHEET_RANGE_BIGBASKET=

# --- Service account credentials (for server-side read access) ---
# Share the sheet with this service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: poll interval (seconds) for near-live sync until push notifications
# / a proper webhook are wired up.
SHEET_SYNC_INTERVAL_SECONDS=60
